# Copiază în infra/.env și schimbă parolele. infra/.env NU se pune în git.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=licurici
POSTGRES_PASSWORD=schimba-ma-postgres
POSTGRES_DB=licurici

REDIS_PASSWORD=schimba-ma-redis

S3_ACCESS_KEY=licurici
S3_SECRET_KEY=schimba-ma-stocare

# Semnătura tokenurilor de acces (ADR-012): minim 32 de caractere aleatoare (ex. openssl rand -hex 32)
JWT_SECRET=schimba-ma-cu-32-de-caractere-aleatoare

WORKER_CONCURRENCY=4

# Rezumatele sesiunii scrise de Claude (ADR-029), doar in backend; gol = doar rezumatele din reguli
ANTHROPIC_API_KEY=

# E-mailurile (confirmarea adresei, parola noua). Implicit Mailpit; in productie releul SMTP Brevo:
# SMTP_URL=smtp://<login>:<cheie>@smtp-relay.brevo.com:587
MAIL_FROM=Licurici <nu-raspunde@licurici.local>
# Adresa panoului: legaturile din e-mailuri duc acolo
APP_URL=http://localhost:8080

# Bull Board (cozile, doar in dezvoltare): http://localhost:3001, utilizator admin
BULLBOARD_PASSWORD=schimba-ma-cozi

# Panoul (dezvoltare): unde gaseste API-ul din browser
PUBLIC_API_URL=http://localhost:3000/api/v1
PUBLIC_API_ORIGIN=http://localhost:3000

# Productie (docker-compose.prod.yml): domeniul (api.<DOMAIN>, panou.<DOMAIN>), e-mailul pentru Let's Encrypt,
# cheia publica age pentru backup (age-keygen; cheia privata NU sta pe server)
DOMAIN=licurici.exemplu.ro
ACME_EMAIL=admin@exemplu.ro
BACKUP_AGE_RECIPIENT=

# Erorile neasteptate in Sentry (proiect in regiunea UE, fara date personale); gol = dezactivat
SENTRY_DSN=

# Metrici Prometheus + Grafana (optional, profilul `monitoring`; docs/operare.md). Gol = /metrics nu exista.
# METRICS_TOKEN: cel putin 24 de caractere (ex. openssl rand -hex 24)
METRICS_TOKEN=
GRAFANA_PASSWORD=
