# Copiază în infra/.env și schimbă parolele. infra/.env NU se pune în git.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=licurici
POSTGRES_PASSWORD=schimba-ma-postgres
POSTGRES_DB=licurici

REDIS_PASSWORD=schimba-ma-redis

S3_ACCESS_KEY=licurici
S3_SECRET_KEY=schimba-ma-stocare

# Semnătura tokenurilor de acces (ADR-012): minim 32 de caractere aleatoare (ex. openssl rand -hex 32)
JWT_SECRET=schimba-ma-cu-32-de-caractere-aleatoare

WORKER_CONCURRENCY=4

# Rezumatele sesiunii scrise de Claude (ADR-029), doar in backend; gol = doar rezumatele din reguli
ANTHROPIC_API_KEY=
