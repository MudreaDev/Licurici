{
  "uid": "licurici-api",
  "title": "Licurici — API și cozi",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "tags": ["licurici"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sincronizare — p95 (ținta: 200 ms)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(licurici_http_request_duration_seconds_bucket{route=\"/api/v1/children/:childId/sessions\",method=\"POST\"}[5m])))",
          "legendFormat": "p95 sincronizare"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cereri pe secundă, după clasa răspunsului",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(licurici_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rutele cele mai lente — p95",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, method, route) (rate(licurici_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cozi BullMQ",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "licurici_queue_jobs{state=~\"waiting|active|failed\"}",
          "legendFormat": "{{queue}} · {{state}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sesiuni primite (24 h)",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(licurici_synced_sessions_total[24h]))" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erori 5xx (1 h)",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(licurici_http_request_duration_seconds_count{status=\"5xx\"}[1h]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memorie API (RSS)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "licurici_process_resident_memory_bytes", "legendFormat": "RSS" }
      ]
    }
  ]
}
