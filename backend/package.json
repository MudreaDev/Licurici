{
  "name": "licurici-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Licurici: API (REST + WebSocket) si worker (BullMQ) - acelasi cod, doua procese.",
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:bullboard": "node dist/bullboard.js",
    "dev:api": "nest start --watch --entryFile main",
    "dev:worker": "nest start --watch --entryFile worker",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:smoke": "nest build && node test/smoke/live-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.9",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
